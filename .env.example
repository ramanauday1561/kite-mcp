# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# -- this repository is public, so a committed key is a published key.
#
# In GitHub Actions the key comes from a repository secret named LLM_API_KEY
# instead; real environment variables always override this file.

# Free key from https://console.groq.com/keys  (no credit card)
LLM_API_KEY=gsk_replace_me

# groq (default) | openrouter | together | huggingface | ollama
LLM_PROVIDER=groq

# Optional: comma-separated override of the models to poll
# LLM_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b
